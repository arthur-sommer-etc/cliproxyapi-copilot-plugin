{
  "name": "cpa-copilot-bridge",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:audit": "pnpm audit --prod",
    "check:go-format": "run-p check:go-format:*",
    "check:go-format:diff": "gofmt -d cmd internal",
    "check:go-format:clean": "test -z \"$(gofmt -l cmd internal)\"",
    "check:go-test": "task test",
    "check:go-vet": "go vet ./...",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:ultracite": "ultracite check",
    "fix": "run-p fix:*",
    "fix:go-format": "gofmt -w cmd internal",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "pnpm@12.16.1"
}
